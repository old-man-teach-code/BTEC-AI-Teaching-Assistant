        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  const desc = data.description || \"\";\n  const start = new Date(data.start_time);\n  const end = new Date(data.end_time);\n\n  const pad = n => n.toString().padStart(2, \"0\");\n\n  // Format dd/MM/yyyy\n  const formatDate = d => `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}`;\n  const formatTime = d => `${pad(d.getHours())}:${pad(d.getMinutes())}`;\n\n  let oneLine;\n  if (\n    start.getFullYear() === end.getFullYear() &&\n    start.getMonth() === end.getMonth() &&\n    start.getDate() === end.getDate()\n  ) {\n    // Cùng ngày → hiển thị giờ trước, ngày sau (dd/MM/yyyy trong ngoặc)\n    const startStr = formatTime(start);\n    const endStr = formatTime(end);\n    const dateStr = formatDate(start);\n\n    oneLine = `🎉 Sự kiện hôm nay: ${desc}\\n🗓️ Thời gian: ${startStr} → ${endStr} (${dateStr})`;\n  } else {\n    // Khác ngày → hiển thị cả giờ + ngày cho từng mốc\n    const startStr = `${formatTime(start)} (${formatDate(start)})`;\n    const endStr = `${formatTime(end)} (${formatDate(end)})`;\n\n    oneLine = `🎉 Sự kiện: ${desc}\\n🗓️ Thời gian: ${startStr} → ${endStr}`;\n  }\n\n  return {\n    json: {\n      ...data,\n      one_line: oneLine\n    }\n  };\n});\n"
