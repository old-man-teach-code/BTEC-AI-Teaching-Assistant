    {
      "parameters": {
        "jsCode": "// Gom tất cả thông báo con từ input\nconst notifications = items.flatMap(item => item.json.notifications || []);\n\n// Nếu không có thông báo\nif (notifications.length === 0) {\n  return [\n    {\n      json: {\n        status: \"error\",\n        message: \"❌ Không có lớp nào để thông báo.\"\n      }\n    }\n  ];\n}\n\n// Dùng Set để tránh trùng lớp\nconst classSet = new Set();\nlet commonMessage = \"\";\n\n// Duyệt thông báo\nnotifications.forEach((n, idx) => {\n  // Regex lấy tên lớp\n  const match = n.message.match(/Lớp\\s+([A-Z0-9]+)/i);\n  if (match) {\n    classSet.add(match[1]); // thêm vào Set, tự động loại trùng\n  }\n\n  // Với thông báo đầu tiên, cắt phần sau tên lớp làm \"nội dung chung\"\n  if (idx === 0) {\n    commonMessage = n.message.replace(/Lớp\\s+[A-Z0-9]+\\s*/i, \"\");\n  }\n});\n\n// Chuyển Set về mảng rồi ghép\nconst combinedClasses = Array.from(classSet).join(\", \");\n\n// Tạo tin nhắn chung\nconst lecturerMessage = `📢Thành công : Lớp ${combinedClasses} ${commonMessage.trim()}`;\n\n// Trả về 1 item duy nhất\nreturn [\n  {\n    json: {\n      status: \"success\",\n      lecturerMessage\n    }\n  }\n];\n"
      },
