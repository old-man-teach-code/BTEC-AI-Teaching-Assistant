      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  const desc = data.description || data.title || \"\";\n  const start = new Date(data.start_time || data.Start);\n  const end = new Date(data.end_time || data.End);\n\n  const pad = n => n.toString().padStart(2, \"0\");\n\n  // Format dd/MM/yyyy\n  const formatDate = d => `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}`;\n  const formatTime = d => `${pad(d.getHours())}:${pad(d.getMinutes())}`;\n  const formatFull = d => `${formatTime(d)} (${formatDate(d)})`;\n\n  // Format thời gian sự kiện\n  let timeStr;\n  if (\n    start.getFullYear() === end.getFullYear() &&\n    start.getMonth() === end.getMonth() &&\n    start.getDate() === end.getDate()\n  ) {\n    // Cùng ngày\n    timeStr = `${formatTime(start)} → ${formatTime(end)} (${formatDate(start)})`;\n  } else {\n    // Khác ngày\n    timeStr = `${formatFull(start)} → ${formatFull(end)}`;\n  }\n\n  // Nếu có reminder thì nối thêm\n  let reminderStr = \"\";\n  if (data.reminder_minutes && !isNaN(data.reminder_minutes)) {\n    const remindDate = new Date(start.getTime() - data.reminder_minutes * 60000);\n    reminderStr = `\\n⏰ Nhắc trước ${data.reminder_minutes} phút (lúc ${formatTime(remindDate)}).`;\n  }\n\n  // Thêm icon vào câu thông báo\n  const oneLine = `🎉 Sự kiện: ${desc}\\n🗓️ Thời gian: ${timeStr}${reminderStr}`;\n\n  return {\n    json: {\n      ...data,\n      one_line: oneLine\n    }\n  };\n});\n"
      },
