        "jsCode": "const results = [];\n\nfor (const item of items) {\n  const rawOutput = item.json.output;\n\n  try {\n    if (rawOutput === \"null\" || rawOutput === null) {\n      results.push({\n        json: { info: \"Output is null\", raw: rawOutput }\n      });\n      continue;\n    }\n\n    let safeJson = rawOutput.trim();\n\n    // Xử lý TH nhiều object không nằm trong array\n    if (safeJson.startsWith(\"{\") && safeJson.includes(\"},\"))\n      safeJson = `[${safeJson}]`;\n\n    const parsed = JSON.parse(safeJson);\n\n    const normalized = Array.isArray(parsed) ? parsed : [parsed];\n\n    for (const obj of normalized) {\n      if (typeof obj === 'object' && obj !== null) {\n        results.push({ json: obj });\n      } else {\n        results.push({\n          json: {\n            error: true,\n            message: \"Parsed item is not an object\",\n            value: obj\n          }\n        });\n      }\n    }\n  } catch (err) {\n    results.push({\n      json: {\n        error: true,\n        message: \"Failed to parse output\",\n        raw: rawOutput,\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
